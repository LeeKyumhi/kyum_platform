# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요.  cp .env.local.example .env.local
# Kakao Maps JS SDK 키 (지도 시각화용, REST 키와 다름). 없으면 지도 대신 안내 문구로 degrade.
# 카카오 콘솔의 JS 키 + "JavaScript SDK 도메인"에 http://localhost:3000 등록 필요.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ---- PortOne V2 결제 (선택) ----
# 관리자콘솔(admin.portone.io)의 상점 ID와 채널 키. 없으면 결제 버튼만 동작하지 않는다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 결제수단 — 채널 종류에 맞춰야 한다. 비우면 CARD.
#   카드 PG(스마트로·KG이니시스 등) 채널 → CARD
#   간편결제 채널(카카오페이·네이버페이 등)  → EASY_PAY
NEXT_PUBLIC_PORTONE_PAY_METHOD=
# 간편결제사 — payMethod=EASY_PAY일 때 필요. 스마트로는 이 값이 없으면 결제창을 열지 않는다.
#   카카오페이 → EASY_PAY_PROVIDER_KAKAOPAY  (네이버페이 → ..._NAVERPAY, 토스페이 → ..._TOSSPAY)
NEXT_PUBLIC_PORTONE_EASY_PAY_PROVIDER=
