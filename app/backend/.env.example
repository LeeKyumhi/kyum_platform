# ===========================================================
# 이 파일을 복사해서 .env 로 만들고, 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore에 등록되어 git에 올라가지 않습니다 (비밀번호 보호).
# ===========================================================

# Supabase 대시보드 > Connect > "Session pooler" 의 값을 사용
# (Session pooler가 IPv4 환경에서 잘 동작해서 권장)

# 예: jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://<HOST>:5432/postgres

# 예: postgres.abcdefghijklmnop  (postgres.<프로젝트참조ID>)
SUPABASE_DB_USER=postgres.<PROJECT_REF>

# 프로젝트 생성 시 정한 데이터베이스 비밀번호
SUPABASE_DB_PASSWORD=<YOUR_DB_PASSWORD>
