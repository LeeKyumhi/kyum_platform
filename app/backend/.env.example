# ===========================================================
# 이 파일을 복사해서 .env 로 만들고, 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore에 등록되어 git에 올라가지 않습니다 (비밀번호 보호).
# ===========================================================

# Supabase 대시보드 > Connect > "Session pooler" 의 값을 사용
# (Session pooler가 IPv4 환경에서 잘 동작해서 권장)

# 예: jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://<HOST>:5432/postgres

# 예: postgres.abcdefghijklmnop  (postgres.<프로젝트참조ID>)
SUPABASE_DB_USER=postgres.<PROJECT_REF>

# 프로젝트 생성 시 정한 데이터베이스 비밀번호
SUPABASE_DB_PASSWORD=<YOUR_DB_PASSWORD>

# ---- Kakao Map REST API (선택) ----
# 역지오코딩/장소검색용. 없으면 GPS 자동감지·장소검색만 비활성, 앱은 정상 동작.
# developers.kakao.com 에서 발급, 따옴표 없이 raw 값만. "카카오맵/로컬(OPEN_MAP_AND_LOCAL)" 서비스 ON 필요.
KAKAO_REST_API_KEY=

# ---- Google Cloud Translation API v2 (선택) ----
# 장소명/카테고리를 영어·중국어로 번역. 없으면 한국어 원문 그대로 표시됨.
# console.cloud.google.com → API 및 서비스 → Cloud Translation API 활성화 후 API 키 발급.
GOOGLE_TRANSLATE_API_KEY=

# ---- Resend(https://resend.com) 트랜잭션 이메일 (선택) ----
# 회원가입 인증메일/비밀번호 재설정메일 발송용. 없으면 발송만 스킵, 앱은 정상 동작(토큰은 정상 발급됨).
# resend.com/api-keys 에서 발급.
RESEND_API_KEY=

# 커스텀 도메인 인증 전까지는 기본값(onboarding@resend.dev) 사용 — 이 발신 주소는 Resend 계정 소유자
# 본인 이메일로만 발송 가능하다는 제약이 있음.
RESEND_FROM_ADDRESS=onboarding@resend.dev

# 인증/재설정 이메일 링크가 가리킬 프론트엔드 주소 (기본값 로컬 개발용)
FRONTEND_URL=http://localhost:3000

# 소셜 로그인 (선택 — 없으면 소셜 버튼 비활성/에러)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# ---- PortOne V2 결제(에스크로) (선택) ----
# admin.portone.io → 결제 연동. 키가 없으면 결제 기능만 비활성, 앱·예약 흐름은 정상.
# ⚠ V2 전용 시크릿 — V1 키를 넣으면 결제 확정 단계에서 401(Invalid API secret)로 조용히 실패한다.
#   발급: 콘솔 [결제연동] → [연동 관리] → [식별코드·API Keys] → [V2 API] → `새로운 API Secret 발급`
#   발급 직후에만 값이 보이고(놓치면 재발급), 만료 기한이 있으며, Owner/Admin 계정만 발급 가능.
#   유효성 확인(서버 올리기 전 1초):
#     curl -s -XPOST https://api.portone.io/login/api-secret -H 'Content-Type: application/json' \
#       -d '{"apiSecret":"<값>"}'   → 200이면 유효 / 401 Invalid API secret이면 무효
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
# 웹훅 시크릿(whsec_...). 설정 시 웹훅 서명(Standard Webhooks)을 강제 검증한다. 비우면 검증 건너뜀(개발용).
PORTONE_WEBHOOK_SECRET=
# 플랫폼 수수료율 (기본 0.15 = 15%)
PAYMENT_COMMISSION_RATE=0.15
